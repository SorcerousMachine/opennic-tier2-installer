# =============================================================================
# opennic-tier2-installer - nginx server block
# =============================================================================
# Owns TCP 443 publicly. TLS-terminates the operator info page and reverse-
# proxies DoH /dns-query to dnsdist on 127.0.0.1:5443.

# Port 80: ACME webroot challenges + HTTPS redirect for everything else.
server {
    listen      80;
    listen [::]:80;
    server_name ${RESOLVER_HOSTNAME};

    access_log off;

    # ACME-HTTP-01 webroot path. Renewals (and the initial issuance with
    # webroot mode) drop tokens here.
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Port 443: TLS termination, DoH proxy, info page.
server {
    listen      443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${RESOLVER_HOSTNAME};

    access_log off;

    ssl_certificate     /etc/letsencrypt/live/${RESOLVER_HOSTNAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${RESOLVER_HOSTNAME}/privkey.pem;

    # Modern TLS profile (Mozilla "intermediate" 2024).
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling        on;
    ssl_stapling_verify on;

    # Security headers. CSP is intentionally tight: the info page is a static
    # single-file document with no JS or external assets.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;

    # DoH reverse proxy. dnsdist 1.9's DoH listener requires HTTP/2; in
    # plaintext mode that means h2c. nginx's grpc_pass speaks h2c upstream,
    # so we use it as a generic HTTP/2 proxy here (despite the gRPC name).
    # dnsdist honours X-Forwarded-For (trustForwardedForHeader=true) so per-
    # IP rate limits see the real client.
    location = /dns-query {
        grpc_pass        grpc://127.0.0.1:5443;
        grpc_set_header  Host $host;
        grpc_set_header  X-Forwarded-For $remote_addr;
        grpc_set_header  X-Forwarded-Proto https;
        # DoH POST bodies are small (RFC 8484 limits the message); 4 KiB is
        # generous. Cap to defend against accidental floods.
        client_max_body_size 4k;
        grpc_read_timeout  10s;
        grpc_send_timeout  10s;
        grpc_connect_timeout 5s;
    }

    # Operator info page (single static index.html, no JS, no external assets).
    location / {
        root  /var/www/${RESOLVER_HOSTNAME};
        index index.html;
        try_files $uri $uri/ =404;
    }
}
