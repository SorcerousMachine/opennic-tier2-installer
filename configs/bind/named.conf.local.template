// =============================================================================
// opennic-tier2-installer - slaved OpenNIC zones
// =============================================================================
// Generated by install.sh. Edit configs/bind/named.conf.local.template and
// re-run install.sh to regenerate, or use scripts/refresh-opennic-config.sh
// to re-pull current OpenNIC infrastructure data and rebuild this file.

// Master servers list - the OpenNIC Tier-1 nameservers we slave from.
// Multiple sources for redundancy; if one is down, BIND tries the next.
masters opennic_tier1 {
${OPENNIC_MASTERS_BLOCK}
};

// Slaved root: contains ICANN TLD delegations *and* OpenNIC TLDs. Replaces
// Debian's default root hints (named.conf.root-hints is empty in our setup).
zone "." {
    type secondary;
    file "/var/cache/bind/db.root.opennic";
    primaries { opennic_tier1; };
    notify no;
};

// Slaved OpenNIC TLDs.
${OPENNIC_TLD_ZONE_BLOCKS}
