-- =============================================================================
-- opennic-tier2-installer - dnsdist configuration
-- =============================================================================
-- dnsdist terminates the public-facing DNS protocols and forwards everything
-- to BIND9 on 127.0.0.1:5353.
--   :53/udp+tcp     -> Do53
--   :853/tcp        -> DoT
--   :8443/udp+tcp   -> DNSCrypt
--   127.0.0.1:5443  -> plaintext DoH; nginx terminates TLS at :443/dns-query
--
-- Generated by install.sh from configs/dnsdist/dnsdist.conf.template.

-- ---------- ACL --------------------------------------------------------------
-- Public resolver: accept queries from the entire internet. Per-IP rate
-- limiting and abuse rules below carry the policy weight.
setACL({'0.0.0.0/0', '::/0'})

-- ---------- listeners --------------------------------------------------------

-- Do53 (UDP + TCP) on the public IPv4.
addLocal('${RESOLVER_IPV4}:53')
${IPV6_DO53}
-- Loopback Do53 listener for any same-host integrations that want to use
-- dnsdist as the entry point (rather than going around it to BIND directly).
-- Used by scripts/integrations/enable-doi.sh to terminate the DNS-over-I2P
-- tunnel; harmless on hosts without integrations enabled.
addLocal('127.0.0.1:53')


-- DoT (TLS over TCP) using the Let's Encrypt cert that the deploy hook
-- mirrors to /etc/dnsdist/tls/.
addTLSLocal('${RESOLVER_IPV4}:853',
            '/etc/dnsdist/tls/fullchain.pem',
            '/etc/dnsdist/tls/privkey.pem')
${IPV6_DOT}
-- DNSCrypt (UDP + TCP). Provider name and resolver-cert files are generated
-- once during install and rotated by scripts/print-stamps.sh-aware tools.
addDNSCryptBind('${RESOLVER_IPV4}:8443',
                '${DNSCRYPT_PROVIDER_NAME}',
                '/etc/dnsdist/dnscrypt/cert.cert',
                '/etc/dnsdist/dnscrypt/cert.key')
${IPV6_DNSCRYPT}
-- DoH on loopback for nginx to reverse-proxy. dnsdist 1.9's DoH requires
-- HTTP/2; in plaintext mode that means h2c. nginx's `grpc_pass` speaks h2c
-- upstream (it's a generic HTTP/2-to-upstream proxy that happens to be named
-- after gRPC). Together they bridge HTTP/1.1+HTTP/2 from the public side to
-- h2c on loopback. trustForwardedForHeader honours nginx's X-Forwarded-For
-- so per-IP rate limits see the real client.
addDOHLocal('127.0.0.1:5443', nil, nil, '/dns-query',
            { trustForwardedForHeader = true })

-- ---------- backend ----------------------------------------------------------

newServer({
    address     = '127.0.0.1:5353',
    name        = 'bind',
    checkType   = 'SOA',
    checkName   = '.',
    -- We're a forwarder, not a recursive resolver behind a CDN; client subnet
    -- carries no value and erodes privacy.
    useClientSubnet = false,
})

setServerPolicy(firstAvailable)

-- ---------- packet cache ----------------------------------------------------
-- Front-edge cache: identical queries don't hit BIND or the wider network.
-- Reduces backend load and reduces our outbound traffic to OpenNIC Tier-1s
-- and gtld-servers - good citizen to upstream operators.
local pc = newPacketCache(10000, {
    maxTTL = 86400,
    minTTL = 0,
    temporaryFailureTTL = 60,  -- briefly cache SERVFAIL so a flapping upstream isn't hammered
    staleTTL = 60,
    dontAge = false,
})
getPool(""):setCache(pc)

-- ---------- abuse controls ---------------------------------------------------
-- Order matters: ANY/non-RD refusals come first, then rate limits.

-- Refuse RFC 8482-encouraged ANY queries (cheap to amplify).
addAction(QTypeRule(DNSQType.ANY), RCodeAction(DNSRCode.REFUSED))

-- Refuse non-recursive queries: we exist to serve recursion to OpenNIC users,
-- not to be a stealth authoritative server for anyone's zone.
addAction(NotRule(RDRule()), RCodeAction(DNSRCode.REFUSED))

-- Per-IP rate limit: 50 qps averaged, /32 IPv4 / /64 IPv6 buckets.
addAction(MaxQPSIPRule(50, 32, 64), DropAction())

-- ---------- privacy ----------------------------------------------------------
-- No query logging is configured. The default `setVerbose(false)` is implicit;
-- we just never call addAction(LogAction(...)).

-- ---------- console ----------------------------------------------------------
-- Loopback-only console for the operator. The console key is rotated on every
-- install and is readable only by root in /etc/dnsdist/console.key.
${CONSOLE_BLOCK}
